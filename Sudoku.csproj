<Project Sdk="Microsoft.NET.Sdk">

  <!-- The solver as a Windows Forms program on .NET 10: dotnet build Solver.sln (bin/<Configuration>/net10.0-windows/). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Sudoku</RootNamespace>
    <AssemblyName>Sudoku</AssemblyName>
    <Title>Sudoku</Title>
    <Description>Sudoku solver</Description>
    <Copyright>Copyright © 2008 Jonny Reckless</Copyright>
    <Version>1.0.0</Version>
    <!-- The code is as it was written in 2008: its own usings, no nullable annotations. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

</Project>
