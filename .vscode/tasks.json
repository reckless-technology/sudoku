{
    // Windows: the build runs in Visual Studio's developer environment (VsDevCmd.bat, found by vswhere), which puts
    // cmake, ninja and cl on the PATH.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "windows": {
                "command": "cmd.exe",
                "args": ["/d", "/c",
                         "for /f \"usebackq delims=\" %i in (`\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -latest -products * -property installationPath`) do call \"%i\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -host_arch=x64 -no_logo && cmake --preset debug && cmake --build --preset debug"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build release",
            "type": "shell",
            "windows": {
                "command": "cmd.exe",
                "args": ["/d", "/c",
                         "for /f \"usebackq delims=\" %i in (`\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -latest -products * -property installationPath`) do call \"%i\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -host_arch=x64 -no_logo && cmake --preset release && cmake --build --preset release"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "type": "shell",
            "windows": {
                "command": "cmd.exe",
                "args": ["/d", "/c",
                         "for /f \"usebackq delims=\" %i in (`\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -latest -products * -property installationPath`) do call \"%i\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -host_arch=x64 -no_logo && cmake --build --preset debug && ctest --preset debug"]
            },
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "test", "isDefault": true},
            "problemMatcher": "$msCompile"
        }
    ]
}
